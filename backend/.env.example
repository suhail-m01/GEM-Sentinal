# GeM-Sentinel — environment template. NEVER commit real secrets.
# Copy to .env for local development and adjust.

ENVIRONMENT=development
APP_ENV=development            # development | production (production disables /demo/* + studio exports)
DEMO_MODE=true                 # forced false when APP_ENV=production

DATABASE_URL=postgresql+psycopg2://<user>:<pass>@127.0.0.1:5432/gem_sentinel
JWT_SECRET=<generate: python -c "import secrets;print(secrets.token_urlsafe(48))">
ENCRYPTION_KEY=<generate: secrets.token_urlsafe(48)>
ENVELOPE_ENCRYPTION_KEY=<generate: secrets.token_urlsafe(48)>

# Login rate limit (spec §12: rate limiting + login-attempt monitoring)
RATE_LIMIT_LOGIN=30/minute

# Secure client-IP: CIDRs of trusted reverse proxies (empty = direct peer only)
TRUSTED_PROXY_CIDRS=

# --- Pluggable AI providers (all optional; deterministic local fallback) ---
GEMINI_API_KEY=
GROQ_API_KEY=
HF_API_TOKEN=
AI_PROVIDER=auto               # auto | gemini | groq | huggingface | local

# --- Email provider (simulated = in-app outbox; smtp = project-controlled inboxes) ---
EMAIL_MODE=simulated
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# Mock source portals (replaceable adapters)
MOCK_PORTAL_URL=http://127.0.0.1:8001
PORTAL_TIMEOUT_SECONDS=2.5

# Razorpay Standard Checkout (use Test Mode keys for demo)
ENABLE_RAZORPAY_PAYMENTS=true
# Mandatory non-refundable application/platform maintenance fee for every bidder submission.
APPLICATION_FEE_AMOUNT=2500
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
