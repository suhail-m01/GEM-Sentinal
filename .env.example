# ---- GeM-Sentinel backend environment (development defaults) ----
# Copy to backend/.env and adjust.

# PostgreSQL connection (per specification: PostgreSQL)
DATABASE_URL=postgresql+psycopg2://gemsentinel:gemsentinel123@127.0.0.1:5432/gem_sentinel

# JWT — change in production!
JWT_SECRET=dev-only-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
# Short-lived token required before an override is accepted (password re-auth)
REAUTH_TOKEN_MINUTES=10

# AES-256 (Fernet) field encryption for PAN / GSTIN / Udyam — change in production!
ENCRYPTION_KEY=dev-only-encryption-key-change-in-production

# AI explainer (advisory only; deterministic fallback when key is absent)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Mock government portals (replace with real authorized APIs via adapters in production)
MOCK_PORTAL_URL=http://127.0.0.1:8001
PORTAL_TIMEOUT_SECONDS=2.5

# ---- SMS gateway for real OTP delivery (OTP is never shown in the UI) ----
# console (default; code goes to the backend log) | twilio | msg91 | textlocal
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=
# TEXTLOCAL_API_KEY=

# File storage
# UPLOAD_DIR=            # defaults to <repo>/storage
MAX_UPLOAD_MB=10

# Environment: development | production
ENVIRONMENT=development

# ---- Frontend environment ----
# The Next.js dev/prod server proxies same-origin /api/* to the backend.
API_URL=http://127.0.0.1:8000
